devtools::install_github("cortes-ciriano-lab/ReConPlot")
install.packages("devtools")
devtools::install_github("cortes-ciriano-lab/ReConPlot")
library("ReConPlot")
cn_data <- data.frame("chr"=c("chr1", "chr2"), "start"=c(1,100000), "end"=c(99999,999999), "copyNumber"=c(1,3), "minorAlleleCopyNumber"=c(0,1))
cn_data
sv_data <- data.frame("chrom1"=c("chr1", "chr1"), "pos1"=c(5,500000), "chrom2"=c("chr1", "chr1"), "pos2"=c(35378, 773351), "strands"=c("+-", "++"))
sv_data
chr_selection <- data.frame(chr="chr1", start=0, end=1000000)
ReConPlot(sv = sv_data, cn=cn_data, chr_selection = chr_selection, legend_SV_types = T, genome_version = "T2T")
sv_data <- data.frame("chr1"=c("chr1", "chr1"), "pos1"=c(5,500000), "chr2"=c("chr1", "chr1"), "pos2"=c(35378, 773351), "strands"=c("+-", "++"))
ReConPlot(sv = sv_data, cn=cn_data, chr_selection = chr_selection, legend_SV_types = T, genome_version = "T2T")
